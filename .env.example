# Google Gemini for Deep Agents.
AGENT_API_KEY=
AGENT_MODEL=gemini-3.5-flash-lite
# NVIDIA Nemotron 3.5 Content Safety. NVIDIA_API_KEY also works as a fallback.
SAFETY_API_KEY=
# Optional ChatOpenAI demo overrides; otherwise uses GOOGLE_API_KEY and Gemini.
# CHAT_API_KEY=
# CHAT_MODEL=gemini-3.5-flash-lite
# CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Policy-check and safety-model routing lives in config/config.yml.

# NVIDIA GLM for the streaming Deep Agent demo.
STREAM_API_KEY=
STREAM_MODEL=z-ai/glm-5.3
STREAM_BASE_URL=https://integrate.api.nvidia.com/v1
